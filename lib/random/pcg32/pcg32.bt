// PCG32 pseudorandom number generator.
//
// Implements the PCG-XSH-RR variant with 64-bit state and 32-bit output.
// Reference: https://www.pcg-random.org/
package pcg32

// #define PCG32_INITIALIZER   { 0x853c49e6748fea9bULL, 0xda3e39cb94b95bdbULL }
const multiplier := 6364136223846793005 as u64

pub struct PCG32 {
	mut state u64
	mut inc u64
}

// Initializes the RNG with the given `init_state` and `init_seq`.
// `init_seq` selects the output sequence (stream).
pub fun (mut rng PCG32) seed(init_state u64, init_seq u64) {
	rng.state = 0 as u64
	rng.inc = (init_seq << 1) | 1 as u64
	_ = rng.next()
	rng.state = rng.state + init_state
	_ = rng.next()
}

// Returns a uniformly distributed random `u8`.
pub fun (mut rng PCG32) u8() u8 {
	return (rng.next() & 0xFF) as u8
}

// Returns a uniformly distributed random `u16`.
pub fun (mut rng PCG32) u16() u16 {
	return (rng.next() & 0xFFFF) as u16
}

// Returns a uniformly distributed random `u32`.
pub fun (mut rng PCG32) u32() u32 {
	return rng.next()
}

// Returns a uniformly distributed random `u32` in `[0, bound)`.
pub fun (mut rng PCG32) bounded(bound u32) u32 {
	if bound == 0 {
		return 0
	}

	// Rejection sampling avoids modulo bias when `bound` is not a power of two.
	threshold := (0 as u32 - bound) % bound
	for {
		r := rng.next()
		if r >= threshold {
			return r % bound
		}
	}
}

// Returns a uniformly distributed random `u64`.
pub fun (mut rng PCG32) u64() u64 {
	a := rng.next() as u64
	b := rng.next() as u64
	return (a << 32) | b
}

// Advances the state and returns the next 32-bit output.
fun (mut rng PCG32) next() u32 {
	old_state := rng.state
	rng.state = old_state * multiplier + rng.inc
	xorshifted := (((old_state >> 18) ^ old_state) >> 27) as u32
	rot := (old_state >> 59) as u32
	return (xorshifted >> rot) | (xorshifted << ((0 as u32 - rot) & 31))
}

